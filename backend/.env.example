# Copy to backend/.env. Real .env files are ignored by Git.
HELPFLOW_APP_NAME=HelpFlow
# List settings use JSON, not comma-separated strings.
HELPFLOW_CORS_ORIGINS=["http://localhost:5173"]
# URL-encode special characters in the password. Use your local account.
HELPFLOW_DATABASE_URL=mysql+asyncmy://helpflow:CHANGE_ME@127.0.0.1:3306/helpflow?charset=utf8mb4
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
# No default signing key. Set a random value of at least 32 bytes before startup.
HELPFLOW_JWT_SECRET_KEY=
HELPFLOW_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Single-process auth limits. Configure a shared gateway limiter for multiple workers.
HELPFLOW_AUTH_RATE_LIMIT_ENABLED=true
HELPFLOW_AUTH_RATE_WINDOW_SECONDS=60
HELPFLOW_AUTH_LOGIN_IP_LIMIT=60
HELPFLOW_AUTH_LOGIN_ACCOUNT_LIMIT=10
HELPFLOW_AUTH_REGISTER_IP_LIMIT=10

# Optional scheduling index. Leave empty for database-only compensation.
HELPFLOW_REDIS_URL=
# Use a distinct key for each environment/database sharing Redis.
HELPFLOW_SLA_REDIS_KEY=helpflow:sla:pending
HELPFLOW_SLA_SCAN_SECONDS=5
HELPFLOW_SLA_COMPENSATE_SECONDS=60
HELPFLOW_SLA_BATCH_SIZE=100

# RAG: keys remain server-side; generation and embedding are separate services.
HELPFLOW_RAG_GENERATION_URL=https://api.deepseek.com
HELPFLOW_RAG_GENERATION_MODEL=deepseek-flash
HELPFLOW_RAG_GENERATION_KEY=
# Compatible embeddings endpoint base (include /v1 if required by provider).
HELPFLOW_RAG_EMBEDDING_URL=
HELPFLOW_RAG_EMBEDDING_MODEL=
HELPFLOW_RAG_EMBEDDING_KEY=
HELPFLOW_RAG_TIMEOUT=45
HELPFLOW_RAG_TOP_K=4
HELPFLOW_RAG_MIN_SCORE=0.5
